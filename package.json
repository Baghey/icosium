{
  "name": "icosium",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "infra:up": "pnpm --filter @icosium/nakama-modules build && docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f --tail=100",
    "dev": "pnpm --parallel --filter @icosium/web --filter @icosium/game-server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
