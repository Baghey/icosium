# ─────────────────────────────────────────────────────────────────────────────
# ICOSIUM : variables d'environnement.
# En ligne (Vercel) : à régler dans Vercel → Project → Settings → Environment Variables.
# En local : copie ce fichier en .env à la racine du dépôt.
# Ne mets JAMAIS le fichier .env sur GitHub (il est déjà dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (comptes, base de données) ──
# Valeurs publiques : Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://sbjhntsohixpkotubpji.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bdWzC85sIv25wu-Be9MKaA_8EW2WeOt

# ── LiveKit Cloud (vocal) ──
# https://cloud.livekit.io → ton projet → Settings → Keys.
# LIVEKIT_API_SECRET est un SECRET : seulement dans Vercel ou dans ton .env local.
LIVEKIT_URL=wss://ton-projet.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
