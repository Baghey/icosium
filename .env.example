# ─────────────────────────────────────────────────────────────────────────────
# ICOSIUM : variables d'environnement locales.
# Copie ce fichier en .env (à la racine du dépôt) et change chaque valeur.
# Ne mets JAMAIS le fichier .env sur GitHub (il est déjà dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Adresse IP de ton ordinateur sur le Wi-Fi (Windows : `ipconfig`, ligne « Adresse IPv4 »).
# Le téléphone ouvrira https://<cette IP>:8443. Il doit être sur le même Wi-Fi.
ICOSIUM_LAN_IP=192.168.1.10

# ── Base de données (PostgreSQL, utilisée par Nakama) ──
POSTGRES_PASSWORD=change-me-postgres

# ── Nakama (comptes) ──
# Clé publique que l'app envoie à Nakama. Pas un vrai secret, mais change-la.
NAKAMA_SERVER_KEY=icosium-dev-server-key
# Secrets serveur : mets de longues chaînes aléatoires (32 caractères ou plus).
NAKAMA_HTTP_KEY=change-me-http-key
NAKAMA_SESSION_KEY=change-me-session-encryption-key
NAKAMA_REFRESH_KEY=change-me-refresh-encryption-key
NAKAMA_CONSOLE_SIGNING_KEY=change-me-console-signing-key
# Console d'administration Nakama : http://localhost:7351
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=change-me-console-password
# Adresse de Nakama vue depuis le serveur Next.js (sur ton ordinateur).
NAKAMA_INTERNAL_URL=http://127.0.0.1:7350

# ── LiveKit (vocal) ──
# La clé secrète doit faire au moins 32 caractères.
LIVEKIT_API_KEY=icosium-dev
LIVEKIT_API_SECRET=change-me-livekit-secret-at-least-32-chars
# Adresse de l'API LiveKit vue depuis le serveur Next.js.
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880

# ── Serveur de jeu (Colyseus) ──
GAME_SERVER_PORT=2567
